{
    "expo": {
      "name": "FlappyBall",
      "slug": "flappyball",
      "version": "1.0.0",
      "orientation": "portrait",
      "userInterfaceStyle": "light",
      "splash": {
        "resizeMode": "contain",
        "backgroundColor": "#87CEEB"
      },
      "assetBundlePatterns": [
        "**/*"
      ],
      "ios": {
        "supportsTablet": true,
        "bundleIdentifier": "com.flappyball.app"
      },
      "android": {
        "adaptiveIcon": {
          "backgroundColor": "#87CEEB"
        },
        "package": "com.flappyball.app"
      },
      "sdkVersion": "52.0.0",
      "plugins": [
        "expo-router",
        "expo-av"
      ],
      "scheme": "flappyball",
      "entryPoint": "./index.js",
      "newArchEnabled": true
    }
  }
  